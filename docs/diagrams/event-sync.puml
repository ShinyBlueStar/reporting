@startuml
title reporting-service — EventSync
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

interface ProjectionEventDispatcher <<Port>> {
}

class ProjectionEventDispatcherImpl {
  .. annotations ..
  Service
  -- fields --
  -projectionEventHandlers: List<ProjectionEventHandler>
  -- methods --
  +dispatch(EventEnvelope eventEnvelope): void
}

abstract class AbstractProjectionEventHandler {
  -- fields --
  -aggregateTypes: String[]
  -- methods --
  +supports(EventEnvelope eventEnvelope): boolean
}

class AccountProjectionEventHandler <<Handler>> {
  .. annotations ..
  Component
  -- fields --
  -accountReportProjectionService: AccountReportProjectionService
  -reportingProjectionMapper: ReportingProjectionMapper
  -- methods --
  +handle(EventEnvelope eventEnvelope): void
}

