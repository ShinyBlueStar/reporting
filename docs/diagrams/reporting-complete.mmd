        @{RabbitListener(
            queues = "${reporting.rabbitmq.queues.card:reporting.card.events}",
            containerFactory = "reportingRabbitListenerContainerFactory"
    )}
        -ReportingEventProcessor reportingEventProcessor
        +consumePartyEvent(Message message, Channel channel) void
        +consumeCardEvent(Message message, Channel channel) void
        +consumeLoanEvent(Message message, Channel channel) void
        +consumeAccountingEvent(Message message, Channel channel) void
        +consumeProductEvent(Message message, Channel channel) void
        -consume(Message message, Channel channel) void
    }

    class ReportingEventProcessor {
