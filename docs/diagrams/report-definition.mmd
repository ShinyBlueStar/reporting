    class ReportDefinitionCreateCommandHandler {
        <<UseCase>>
        @{Component}
        -ReportDefinitionService reportDefinitionService
        -ReportDefinitionMapper reportDefinitionMapper
        -ReportSqlGuard reportSqlGuard
