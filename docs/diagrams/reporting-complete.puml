  +integrationEventsExchange(@Value("${reporting.rabbitmq.exchange:banking.integration.events}"): TopicExchange
  +deadLetterExchange(@Value("${reporting.rabbitmq.dead-letter-exchange:banking.integration.dlx}"): DirectExchange
  +partyQueue(@Value("${reporting.rabbitmq.queues.party:reporting.party.events}"): Queue
  +cardQueue(@Value("${reporting.rabbitmq.queues.card:reporting.card.events}"): Queue
  +loanQueue(@Value("${reporting.rabbitmq.queues.loan:reporting.loan.events}"): Queue
  +accountingQueue(@Value("${reporting.rabbitmq.queues.accounting:reporting.accounting.events}"): Queue
  +productQueue(@Value("${reporting.rabbitmq.queues.product:reporting.product.events}"): Queue
  +partyBinding(Queue partyQueue, TopicExchange integrationEventsExchange, @Value("${reporting.rabbitmq.routing-keys.party:party.events}"): Binding
  +cardBinding(Queue cardQueue, TopicExchange integrationEventsExchange, @Value("${reporting.rabbitmq.routing-keys.card:card.events}"): Binding
  +loanBinding(Queue loanQueue, TopicExchange integrationEventsExchange, @Value("${reporting.rabbitmq.routing-keys.loan:loan.events}"): Binding
  +accountingBinding(Queue accountingQueue, TopicExchange integrationEventsExchange, @Value("${reporting.rabbitmq.routing-keys.accounting:accounting.events}"): Binding
  +productBinding(Queue productQueue, TopicExchange integrationEventsExchange, @Value("${reporting.rabbitmq.routing-keys.product:product.events}"): Binding
  +reportingRabbitListenerContainerFactory(ConnectionFactory connectionFactory): SimpleRabbitListenerContainerFactory
  -deadLetterQueue(String queueName, String dlxName): Queue
}

